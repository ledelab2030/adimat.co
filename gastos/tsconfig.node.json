{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "node_modules/.tsbuildcache/node",
    "tsBuildInfoFile": "node_modules/.tsbuildcache/node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
