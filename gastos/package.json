{
  "name": "gastos",
  "version": "1.0.0",
  "private": true,
  "description": "PWA local-first para registrar egresos personales en COP. Offline, instalable, sincronizacion opcional.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "idb": "^8.0.0",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^22.9.0",
    "autoprefixer": "^10.4.20",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  }
}
